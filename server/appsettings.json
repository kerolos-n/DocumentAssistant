{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "DocumentAssistant",
    "Audience": "DocumentAssistant",
    "ExpirationMinutes": 60
  },
  "Ingestion": {
    "ChunkSize": 1000,
    "ChunkOverlap": 200,
    "EmbeddingBatchSize": 64
  },
  "Retrieval": {
    "TopK": 5,
    "SimilarityThreshold": 0.5
  },
  "Gemini": {
    "EmbeddingModel": "gemini-embedding-001",
    "ChatModel": "gemini-3.8-flash",
    "ChatMaxOutputTokens": 1024,
    "ChatTimeoutSeconds": 30
  },
  "Kestrel": {
    "Limits": {
      "MaxRequestBodySize": 26214400
    }
  },
  "AllowedHosts": "*"
}
