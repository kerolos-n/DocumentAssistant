# Local ASP.NET Core configuration. Copy to .env and replace the placeholders.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:3000

# PostgreSQL connection used by ASP.NET Core Identity and Entity Framework.
ConnectionStrings__DefaultConnection="Host=localhost;Port=5432;Database=documentassistant;Username=postgres;Password=change-me"

# Generate a unique key (at least 32 bytes) for each environment.
Jwt__Key=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_BYTES
Jwt__Issuer=DocumentAssistant
Jwt__Audience=DocumentAssistant
Jwt__ExpirationMinutes=60

# Browser origin allowed to call the API.
Client__Origin=http://localhost:4200
